# Copy this file to .env.local for running the site on your own computer,
# or add the same names in Vercel → Project → Settings → Environment Variables.

# Password for the admin page at /admin. Use a long one.
ADMIN_PASSWORD=

# A GitHub fine-grained access token with "Contents: Read and write" on this
# repository. Needed on the live site so the admin page can save changes.
# Leave it empty on your own computer: the admin then writes the files directly.
ADMIN_GITHUB_TOKEN=

# Only needed outside Vercel (Vercel fills these in automatically):
# GITHUB_REPO=elroe-e/Portfolio
# GITHUB_BRANCH=main

# Your site's address once it has a domain, for link previews.
# NEXT_PUBLIC_SITE_URL=https://example.com
